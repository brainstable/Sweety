{
  "name": "sweety-map",
  "version": "0.1.0",
  "description": "Dependency-free modular JavaScript library for interactive maps.",
  "type": "module",
  "main": "./dist/sweety.umd.cjs",
  "module": "./dist/sweety.es.js",
  "style": "./dist/sweety.css",
  "exports": {
    ".": {
      "import": "./dist/sweety.es.js",
      "require": "./dist/sweety.umd.cjs"
    },
    "./dist/sweety.css": "./dist/sweety.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --open /examples/",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "keywords": [
    "map",
    "maps",
    "leaflet",
    "geojson",
    "tiles",
    "gis",
    "web-mercator"
  ],
  "author": "Brainstable",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
