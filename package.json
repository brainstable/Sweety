{
  "name": "sweety-map",
  "version": "0.2.0",
  "description": "Модульная JavaScript-библиотека интерактивных карт без runtime-зависимостей.",
  "type": "module",
  "main": "./dist/sweety.umd.cjs",
  "module": "./dist/sweety.es.js",
  "style": "./dist/sweety.css",
  "unpkg": "./dist/sweety.umd.js",
  "jsdelivr": "./dist/sweety.umd.js",
  "homepage": "https://brainstable.github.io/Sweety/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainstable/sweety.git"
  },
  "bugs": {
    "url": "https://github.com/brainstable/sweety/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/sweety.es.js",
      "require": "./dist/sweety.umd.cjs"
    },
    "./dist/sweety.css": "./dist/sweety.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --open /examples/",
    "build": "vite build && node scripts/copy-umd.mjs",
    "build:lib": "vite build",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "vite preview --config vite.site.config.js",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "commit-and-tag-version",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "smoke:demo": "node scripts/smoke-demo.mjs"
  },
  "keywords": [
    "map",
    "maps",
    "geojson",
    "tiles",
    "gis",
    "web-mercator"
  ],
  "author": "Brainstable",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
