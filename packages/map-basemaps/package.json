{
  "name": "sweety-map-basemaps",
  "version": "0.1.0",
  "description": "Каталог подложек и менеджер базовых слоёв для Sweety: OSM, Carto, Esri, Mapbox и другие.",
  "type": "module",
  "main": "./dist/map-basemaps.umd.cjs",
  "module": "./dist/map-basemaps.es.js",
  "types": "./types/index.d.ts",
  "style": "./dist/map-basemaps.css",
  "unpkg": "./dist/map-basemaps.umd.js",
  "jsdelivr": "./dist/map-basemaps.umd.js",
  "homepage": "https://github.com/brainstable/sweety/tree/main/packages/map-basemaps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainstable/sweety.git",
    "directory": "packages/map-basemaps"
  },
  "bugs": {
    "url": "https://github.com/brainstable/sweety/issues"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/map-basemaps.es.js",
      "require": "./dist/map-basemaps.umd.cjs"
    },
    "./light": {
      "types": "./types/index.d.ts",
      "import": "./dist/map-basemaps.light.es.js",
      "require": "./dist/map-basemaps.light.umd.cjs"
    },
    "./style.css": "./dist/map-basemaps.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "sweety",
    "map",
    "basemaps",
    "tiles",
    "tile-providers",
    "osm",
    "carto",
    "mapbox"
  ],
  "author": "Brainstable",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "sweety-map": "^0.1.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "vite build && vite build --config vite.light.config.js && node scripts/copy-umd.mjs",
    "size": "node scripts/check-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  }
}
